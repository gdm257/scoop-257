{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "",
    "description": "",
    "homepage": "",
    "license": "",
    "suggest": { "uv": ["main/uv"] },
    "url": "https://unlicense.org/UNLICENSE",
    "pre_install": [
        "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.vbs') -Destination (Join-Path $dir 'command-wrapper.vbs')",
        "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.cmd') -Destination (Join-Path $dir 'command-wrapper.cmd')"
    ],
    "installer": {
        "script": [
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\uv-env\\uv-env.cmd') -Destination (Join-Path $dir 'uv-env.cmd')",
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\uv-env\\uv-env.vbs') -Destination (Join-Path $dir 'uv-env.vbs')",
            "$env:UV_PYTHON_INSTALL_DIR = Join-Path $dir 'py'",
            "$env:UV_PYTHON_BIN_DIR = Join-Path $dir 'py\\bin'",
            "$env:UV_CACHE_DIR = Join-Path $dir 'uv-cache'",
            "$env:UV_PYTHON_PREFERENCE = 'only-managed'",
            "git clone --recurse-submodules https://github.com/owner/repo \"$dir\\repo\"",
            "Get-ChildItem \"$dir\\repo\\*\" -Force | Move-Item -Destination \"$dir\" ",
            "uv --directory \"$dir\" init",
            "uv --directory \"$dir\" add -r requirements.txt",
            "uv --directory \"$dir\" sync"
        ]
    },
    "bin": [["uv-env.cmd", "shim-name", "uv run main.py"]],
    "shortcuts": [
        ["uv-env.vbs", "GUI Name", "uv run main.pyw", "Icon.ico"]
    ]
}
