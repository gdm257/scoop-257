{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "",
    "description": "",
    "homepage": "",
    "license": "",
    "suggest": { "bun": ["bun"] },
    "url": "https://unlicense.org/UNLICENSE",
    "pre_install": [
        "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.vbs') -Destination (Join-Path $dir 'command-wrapper.vbs')",
        "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.cmd') -Destination (Join-Path $dir 'command-wrapper.cmd')"
    ],
    "installer": {
        "script": [
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\env-wrapper\\env-wrapper.cmd') -Destination (Join-Path $dir 'env-wrapper.cmd')",
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\env-wrapper\\env-wrapper.vbs') -Destination (Join-Path $dir 'env-wrapper.vbs')",
            "Set-Content (Join-Path $dir 'app-env.cmd') @(",
            "    'set \"BUN_INSTALL_CACHE_DIR=%~dp0bun-cache\"'",
            ")",
            "$env:BUN_INSTALL_CACHE_DIR = Join-Path $dir 'bun-cache'",
            "git clone --recurse-submodules https://github.com/owner/repo \"$dir\\repo\"",
            "Get-ChildItem \"$dir\\repo\\*\" -Force | Move-Item -Destination \"$dir\" ",
            "Set-Location $dir",
            "bun install"
        ]
    },
    "bin": [["env-wrapper.cmd", "shim-name", "bun run main.ts"]],
    "shortcuts": [
        ["env-wrapper.vbs", "GUI Name", "bun run main.ts", "Icon.ico"]
    ]
}
