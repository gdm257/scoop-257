{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "2.0",
    "description": "FrameView is an application for measuring frame rates, frame times, power, and performance-per-watt on a wide range of graphics cards",
    "homepage": "https://www.nvidia.com/en-us/geforce/technologies/frameview/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://images.nvidia.com/content/geforce/technologies/frameview/FrameView_2.0/FrameViewSetup.exe#/dl.7z",
            "installer": {
                "script": [
                    "Move-Item -Path \"$dir\\FrameView_x64.exe\" -Destination \"$dir\\FrameView.exe\""
                ]
            }
        },
        "arm64": {
            "url": "https://images.nvidia.com/content/geforce/technologies/frameview/ARM64/FrameViewSetup.exe#/dl.7z",
            "installer": {
                "script": [
                    "Move-Item -Path \"$dir\\FrameView_arm64.exe\" -Destination \"$dir\\FrameView.exe\"",
                    "Move-Item -Path \"$dir\\FrameView_arm64.nvi\" -Destination \"$dir\\FrameView.nvi\""
                ]
            }
        }
    },
    "extract_dir": "FrameView",
    "shortcuts": [["FrameView.exe", "FrameView"]],
    "persist": ["Settings.ini"]
}
